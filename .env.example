# cp .env.example .env

APP_PORT=8080

# The backend runs inside the Compose network, so it uses the service name
# and the container port for Platform PostgreSQL.
APP_DATABASE_URL=host=platform-db port=5432 user=platform password=platform_password dbname=platform sslmode=disable TimeZone=UTC

APP_NAME=platform
APP_USER=platform
APP_PASSWORD=platform_password
APP_HOST_PORT=5432

APP_MAX_OPEN_CONNS=10
APP_MAX_IDLE_CONNS=5
APP_CONN_MAX_LIFETIME=30m
APP_CONN_MAX_IDLE_TIME=5m
APP_PING_TIMEOUT=5s
APP_SHUTDOWN_TIMEOUT=10s

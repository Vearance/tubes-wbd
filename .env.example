# cp .env.example .env

BACKEND_PORT=8080

# The backend runs inside the Compose network, so it uses the service name
# and the container port for Platform PostgreSQL.
PLATFORM_DATABASE_URL=host=platform-db port=5432 user=platform password=platform_password dbname=platform sslmode=disable TimeZone=UTC

PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_password
PLATFORM_DB_HOST_PORT=5432

# cp .env.example .env

APP_PORT=8080

# The backend runs inside the Compose network, so it uses the service name and the container port for Platform PostgreSQL.
APP_DATABASE_URL=host=platform-db port=5432 user=platform password=platform_password dbname=platform sslmode=disable TimeZone=UTC

# Used only when no platform admin exists yet to make new admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=password

# Testing can only be done in http(?)
APP_COOKIE_SECURE=false

APP_NAME=platform
APP_USER=platform
APP_PASSWORD=platform_password
APP_HOST_PORT=5432

APP_MAX_OPEN_CONNS=10
APP_MAX_IDLE_CONNS=5
APP_CONN_MAX_LIFETIME=30m
APP_CONN_MAX_IDLE_TIME=5m
APP_PING_TIMEOUT=5s

# AuthN session policy
APP_IDLE_TIMEOUT=30m
APP_ABSOLUTE_LIFETIME=8h
APP_ROTATION_INTERVAL=15m
APP_ROTATION_GRACE_PERIOD=30s

APP_SHUTDOWN_TIMEOUT=10s

TARGET_DB_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

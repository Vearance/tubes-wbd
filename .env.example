# cp .env.example .env

APP_PORT=8080

# Vite uses localhost outside Docker; Compose overrides this with the backend service name.
BACKEND_HOST=localhost

# The backend runs inside the Compose network, so it uses the service name and the container port for Platform PostgreSQL.
APP_DATABASE_URL=host=platform-db port=5432 user=platform password=platform_password dbname=platform sslmode=disable TimeZone=UTC

# RabbitMQ is a separate Compose service; use localhost when running backend processes locally.
APP_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
APP_RABBITMQ_QUEUE=migration.executions

# Used only when no platform admin exists yet to make new admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=password

# Testing can only be done in http(?)
APP_COOKIE_SECURE=false

APP_NAME=platform
APP_USER=platform
APP_PASSWORD=platform_password
APP_HOST_PORT=5433

APP_MAX_OPEN_CONNS=10
APP_MAX_IDLE_CONNS=5
APP_CONN_MAX_LIFETIME=30m
APP_CONN_MAX_IDLE_TIME=5m
APP_PING_TIMEOUT=5s

# AuthN session policy
APP_IDLE_TIMEOUT=30m
APP_ABSOLUTE_LIFETIME=8h
APP_ROTATION_INTERVAL=15m
APP_ROTATION_GRACE_PERIOD=30s

# Viewer pagination
APP_VIEWER_DEFAULT_PAGE_SIZE=50
APP_VIEWER_MAX_PAGE_SIZE=100

APP_SHUTDOWN_TIMEOUT=10s

TARGET_DB_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

TEST_DB_NAME=targetdb
TEST_DB_USER=target
TEST_DB_PASSWORD=target_password
TEST_DB_HOST_PORT=5434

# Observability (OpenTelemetry Collector + Tempo + Loki + Prometheus + Grafana)
APP_ENV=development
APP_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Use "console" or "otlp,console" to print scrubbed OpenTelemetry spans as JSON to stderr
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER_ARG=1.0
RABBITMQ_PROMETHEUS_PORT=15692
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
LOKI_PORT=3100
TEMPO_PORT=3200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

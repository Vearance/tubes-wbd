      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status_class) (rate(bscheme_http_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"

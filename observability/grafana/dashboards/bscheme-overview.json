      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(bscheme_auth_logins_total{outcome!=\"success\"}[$__range]))) or vector(0)",
          "instant": true,
          "legendFormat": "failed_logins",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,

      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (increase(bscheme_migration_queue_wait_duration_seconds_bucket[15m])))",
